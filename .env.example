# ============================================================================
# backend_tms-api — 환경변수 템플릿 (ste/backend_sample 패턴 기반)
# 사용법: cp .env.example .env  →  값 본인 환경에 맞게 수정
# ============================================================================

# ── 환경 ─────────────────────────────────────────────────────
ENV=development
LOG_LEVEL=DEBUG

# ── JWT / Bcrypt ────────────────────────────────────────────
# JWT_SECRET / SECRET_KEY: prod 에서 반드시 신규 랜덤 값으로 교체.
# 생성 예: openssl rand -hex 32
JWT_SECRET=dev_secret_key_change_me
ALGORITHM=HS256
BCRYPT_ROUNDS=10
SECRET_KEY=dev_secret_key_change_me

# ── Server ──────────────────────────────────────────────────
PROTOCOL=http
HOST=localhost
PORT=8080

# ── Database (단일 — 개발용) ────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=rootpassword
DB_DATABASE=tms

# ── Database (운영 — Read/Write 분리) ──────────────────────
# DB_WRITE_HOST=
# DB_READ_HOST=

# ── DB 타임아웃/제한 ────────────────────────────────────────
DB_READ_TIMEOUT=30
DB_WRITE_TIMEOUT=600
DB_MAX_EXEC_MS=30000
DB_LOCK_WAIT_TIMEOUT=10

# ── DB 커넥션 풀 ────────────────────────────────────────────
DB_WRITE_POOL_SIZE=10
DB_WRITE_MAX_OVERFLOW=20
DB_READ_POOL_SIZE=20
DB_READ_MAX_OVERFLOW=30

# ── ORM ─────────────────────────────────────────────────────
ORM_LAZY_DEFAULT=raise

# ── Redis (단일 — 개발용) ───────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ── Redis (운영 — Read/Write 분리) ─────────────────────────
# REDIS_WRITE_HOST=
# REDIS_READ_HOST=

# ── Redis TTL ───────────────────────────────────────────────
USER_CACHE_TTL=300
RBAC_USER_TENANT_TTL=300
RBAC_GROUP_CODES_TTL=300
REDIS_SESSION_MAX_AGE=3600

# ── Token TTL ───────────────────────────────────────────────
ACCESS_TTL=1800
REFRESH_TTL=8000

# ── Headers ─────────────────────────────────────────────────
CLIENT_TYPE_HEADER=X-Client-Type
DEVICE_KEY_HEADER=X-Device-Key

# ── Cookies ─────────────────────────────────────────────────
BROWSER_ID_COOKIE_NAME=browser_id
REFRESH_TOKEN_COOKIE_NAME=refresh_token
BROWSER_COOKIE_HTTPONLY=true
BROWSER_COOKIE_SAMESITE=lax
BROWSER_COOKIE_SECURE=false
REFRESH_COOKIE_HTTPONLY=true
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_SECURE=false

# ── CORS ────────────────────────────────────────────────────
ALLOWED_ORIGINS=[]
ALLOWED_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|192\.168\.\d{1,3}\.\d{1,3}|10\.\d{1,3}\.\d{1,3}\.\d{1,3}|172\.(1[6-9]|2[0-9]|3[01])\.\d{1,3}\.\d{1,3})(:\d+)?$

# ── OTP ─────────────────────────────────────────────────────
OTP_SEND_LIMIT=3
OTP_BLOCK_SEC=60
OTP_MAX_TRIES=5
OTP_TTL=180
OTP_OK_TTL=900
OTP_GRACE_SEC=5

# ── SMTP ────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=

# ── Branding ────────────────────────────────────────────────
APP_NAME=TMS
BRAND_LOGO_URL=http://localhost:9000/tms-app/public/branding/logo.png
BRAND_PRIMARY_COLOR=#3B82F6
COMPANY_ADDRESS=추후 수정 : 회사 주소

# ── MinIO / S3 ──────────────────────────────────────────────
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=tms-app
MINIO_REGION=us-east-1
MINIO_PRESIGNED_UPLOAD_TTL=86400
MINIO_PRESIGNED_DOWNLOAD_TTL=86400
MINIO_TEMP_PREFIX=tmp

# ── 기타 ────────────────────────────────────────────────────
ROOT_PATH=
TIMEZONE=Asia/Seoul
PURGE_GRACE_DAYS=30

# ── OAuth (TMS 는 v1 미사용 — 비워둠) ──────────────────────
OAUTH_STATE_TTL=600
FRONTEND_URL=http://localhost:5173

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/oauth/google/callback

KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8080/auth/oauth/kakao/callback

APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=http://localhost:8080/auth/oauth/apple/callback

# ── AI Intake (D/O 자동 추출) ───────────────────────────────
# AI_INTAKE_PROVIDER 비우면 /api/v1/ai-intake/* 가 503 반환 (기능 비활성).
#
# 옵션 1 (무료, 추천 시작점): Gemini
#   AI_INTAKE_PROVIDER=gemini
#   GEMINI_API_KEY=...   ← aistudio.google.com → "Get API key" (카드 등록 불필요)
#   무료 한도: gemini-2.0-flash 분당 15회 / 일 1500회
#
# 옵션 2 (유료, 정확도 우선): Anthropic Claude
#   AI_INTAKE_PROVIDER=anthropic
#   ANTHROPIC_API_KEY=...  ← console.anthropic.com → API Keys (카드 필요)
#   비용: ~$0.07/D/O (Opus) 또는 ~$0.014/D/O (Sonnet)
#
# AI_INTAKE_MODEL 비우면 provider 별 default 사용.
# 절대 git 에 커밋하지 말 것 — .env 는 .gitignore 에 있다.
AI_INTAKE_PROVIDER=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
AI_INTAKE_MODEL=
