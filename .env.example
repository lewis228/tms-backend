# ============================================================================
# backend_tms-api — 환경변수 템플릿
#
# 사용법:
#   cp .env.example .env
#   # .env 의 값을 본인 환경에 맞게 수정
#
# 이 파일은 "로컬 개발자가 채워야 할 키 목록" 역할. 값은 전부 더미.
# 실제 값은 .env 에 (gitignore 됨) 개인별로 관리.
#
# APP_ENV:
#   - local  → 이 .env 파일의 값 사용 (로컬 개발)
#   - dev    → AWS Parameter Store 에서 로드 (EC2 dev)
#   - prod   → AWS Parameter Store 에서 로드 (EC2 prod)
# ============================================================================

# ── 환경 구분 ────────────────────────────────────────────────
APP_ENV=local
ENV=development
LOG_LEVEL=DEBUG

# ── Secrets (로컬 전용 — 서버는 Parameter Store) ─────────────
JWT_SECRET=local-dev-secret-change-me
SECRET_KEY=local-dev-secret-change-me

# ── Server ──────────────────────────────────────────────────
PROTOCOL=http
HOST=localhost
PORT=8080

# ── Database (로컬 Docker MySQL) ─────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=rootpassword
DB_DATABASE=tms

# Read/Write split (prod)
# DB_WRITE_HOST=
# DB_READ_HOST=

# ── Redis (로컬 Docker Redis — plain, no TLS) ────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_SSL=false

# Read/Write split (prod)
# REDIS_WRITE_HOST=
# REDIS_READ_HOST=

# ── SMTP (비밀번호 비움. 실제 값은 .env 에만) ────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=

# ── Branding ────────────────────────────────────────────────
APP_NAME=TMS

# ── MinIO / S3 ──────────────────────────────────────────────
#   로컬: MinIO (http://localhost:9000)
#   서버: Parameter Store 에서 S3_BUCKET_STORAGE / S3_PUBLIC_URL 자동 로드
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=tms-app

# ── Frontend ────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── OAuth (비활성화 시 비움) ─────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/oauth/google/callback

KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8080/auth/oauth/kakao/callback

APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=http://localhost:8080/auth/oauth/apple/callback

# ── AWS (서버 전용) ─────────────────────────────────────────
#   로컬에서는 비워둠. 서버 EC2 는 IAM Role 로 자동 인증.
AWS_REGION=ap-northeast-2

# ── AI Intake (Claude API) ──────────────────────────────────
ANTHROPIC_API_KEY=
