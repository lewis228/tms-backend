# ============================================================================
# 운영 환경변수 템플릿. 서버에서 다음으로 복사 후 시크릿을 채운다:
#   cp .env.prod.example .env.prod
# deploy.sh 가 `docker compose --env-file .env.prod` 로 이 파일을 사용한다.
# (변수 치환 + 컨테이너 주입 모두 이 파일에서)
# ============================================================================

# ── 환경 ────────────────────────────────────────────────────
ENV=production
LOG_LEVEL=INFO
TIMEZONE=Asia/Seoul

# ── 시크릿 (반드시 변경) ────────────────────────────────────
# 생성: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
SECRET_KEY=CHANGE_ME_same_as_JWT_SECRET
ALGORITHM=HS256
BCRYPT_ROUNDS=10

# ── 서버 ────────────────────────────────────────────────────
PROTOCOL=http
HOST=0.0.0.0
PORT=8080

# ── DB (compose 의 mysql 컨테이너) ──────────────────────────
# DB_PASSWORD 와 MYSQL_ROOT_PASSWORD 는 반드시 동일하게.
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=CHANGE_ME_db_password
DB_DATABASE=tms
MYSQL_ROOT_PASSWORD=CHANGE_ME_db_password

# 1GB RAM — 커넥션 풀 축소
DB_WRITE_POOL_SIZE=5
DB_WRITE_MAX_OVERFLOW=10
DB_READ_POOL_SIZE=8
DB_READ_MAX_OVERFLOW=12
ORM_LAZY_DEFAULT=raise

# ── Redis (compose 의 redis 컨테이너) ───────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ── MinIO (compose 의 minio 컨테이너) ───────────────────────
# MINIO_PUBLIC_URL 은 브라우저가 접근할 주소(presigned). 9000 포트 오픈 필요(선택).
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_URL=http://168.107.40.234:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGE_ME_minio_secret
MINIO_BUCKET=tms-app
MINIO_REGION=us-east-1

# ── 프론트 빌드/리다이렉트 공개 URL (compose web build args 치환) ──
PUBLIC_URL=http://168.107.40.234
FRONTEND_URL=http://168.107.40.234

# ── CORS / 쿠키 (동일 출처라 사실상 무관, http 이므로 secure=false) ──
ALLOWED_ORIGINS=["http://168.107.40.234"]
BROWSER_COOKIE_SECURE=false
REFRESH_COOKIE_SECURE=false
BROWSER_COOKIE_SAMESITE=lax
REFRESH_COOKIE_SAMESITE=lax

# ── 토큰 TTL ────────────────────────────────────────────────
ACCESS_TTL=1800
REFRESH_TTL=8000

# ── SMTP (선택 — 비우면 콘솔 출력) ──────────────────────────
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=

# ── AI Intake (선택 — 비우면 /ai-intake 503) ───────────────
AI_INTAKE_PROVIDER=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
AI_INTAKE_MODEL=

# ── 이하: Settings 필수 키 (기본값 그대로 두면 됨) ──────────
DB_READ_TIMEOUT=30
DB_WRITE_TIMEOUT=600
DB_MAX_EXEC_MS=30000
DB_LOCK_WAIT_TIMEOUT=10
USER_CACHE_TTL=300
RBAC_USER_TEAM_TTL=300
RBAC_GROUP_CODES_TTL=300
REDIS_SESSION_MAX_AGE=3600
CLIENT_TYPE_HEADER=X-Client-Type
DEVICE_KEY_HEADER=X-Device-Key
BROWSER_ID_COOKIE_NAME=browser_id
REFRESH_TOKEN_COOKIE_NAME=refresh_token
BROWSER_COOKIE_HTTPONLY=true
REFRESH_COOKIE_HTTPONLY=true
ALLOWED_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|192\.168\.\d{1,3}\.\d{1,3}|10\.\d{1,3}\.\d{1,3}\.\d{1,3}|172\.(1[6-9]|2[0-9]|3[01])\.\d{1,3}\.\d{1,3})(:\d+)?$
OTP_SEND_LIMIT=3
OTP_BLOCK_SEC=60
OTP_MAX_TRIES=5
OTP_TTL=180
OTP_OK_TTL=900
OTP_GRACE_SEC=5
APP_NAME=TMS
BRAND_LOGO_URL=http://168.107.40.234:9000/tms-app/public/branding/logo.png
BRAND_PRIMARY_COLOR=#3B82F6
COMPANY_ADDRESS=TMS Demo
MINIO_PRESIGNED_UPLOAD_TTL=86400
MINIO_PRESIGNED_DOWNLOAD_TTL=86400
MINIO_TEMP_PREFIX=tmp
ROOT_PATH=
PURGE_GRACE_DAYS=30
OAUTH_STATE_TTL=600
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://168.107.40.234/auth/oauth/google/callback
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://168.107.40.234/auth/oauth/kakao/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=http://168.107.40.234/auth/oauth/apple/callback
